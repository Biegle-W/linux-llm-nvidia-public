diff --git a/tests/mm3_gguf_test.cu b/tests/mm3_gguf_test.cu
index f1856ab..6809f14 100644
--- a/tests/mm3_gguf_test.cu
+++ b/tests/mm3_gguf_test.cu
@@ -54,7 +54,11 @@ template <class T>
 T* dev(const std::vector<T>& h) {
     T* p = nullptr;
     CU(cudaMalloc(&p, std::max<size_t>(1, h.size()) * sizeof(T)));
-    if (!h.empty()) CU(cudaMemcpy(p, h.data(), h.size() * sizeof(T), cudaMemcpyHostToDevice));
+    if (!h.empty()) {
+        CU(cudaMemcpy(p, h.data(), h.size() * sizeof(T), cudaMemcpyHostToDevice));
+        // Kernels use a nonblocking stream: finish default-stream uploads first.
+        CU(cudaStreamSynchronize(nullptr));
+    }
     return p;
 }
