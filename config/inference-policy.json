{
  "schema": 1,
  "idle_timeout_s": 600,
  "lifecycle_telemetry": true,
  "visible_terminals_required": true,
  "context_tradeoffs": "Configure context from engine KV capacity and available host RAM/VRAM with resource reserves; distinguish calculated capacity from full-context quality evidence.",
  "validation": {
    "default": "short-actual-harness-tool-call-then-unload",
    "full_context_stress_requires_explicit_user_request": true,
    "calculate_context_from_memory": true,
    "unload_after_smoke": true,
    "benchmark_during_short_tool_call": true,
    "benchmark_metrics": [
      "prefill_tps",
      "ttft_s",
      "decode_tps"
    ],
    "benchmark_excludes": [
      "model_loading",
      "followup_answer"
    ],
    "benchmark_output_format": [
      "model_quant",
      "engine",
      "prefill_tps",
      "ttft_s",
      "decode_tps",
      "context_limit_tokens",
      "storage_size_decimal_gb",
      "storage_location"
    ]
  }
}
